# PostgreSQL Database Configuration
POSTGRES_USER=tea_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=tunorth-tea_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://tea_user:your_secure_password_here@localhost:5432/tunorth-tea_db?sslmode=disable

# Backend API Configuration
BACKEND_PORT=8080
ALLOWED_ORIGINS=https://tea.tn.ac.th,http://tea.local,http://192.168.165.11:8010,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8010

# Better Auth Configuration
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Workspace OAuth 2.0 (@tn.ac.th)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
